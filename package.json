{
  "name": "yip-yip",
  "version": "1.3.1",
  "description": "A keyboard-first search interface for web pages.",
  "repository": "https://github.com/comake/yip-yip.git",
  "author": "Comake, Inc.",
  "license": "BSD-4-Clause",
  "private": false,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "detect-browser": "^5.2.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^11.2.7",
    "@types/node": "^24.13.3",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "vite": "^8.2.1",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.10",
    "wxt": "^0.21.4"
  },
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt -b chrome --mv3",
    "dev:firefox": "wxt -b firefox --mv2",
    "build": "yarn build:chromium && yarn build:firefox",
    "build:chromium": "wxt build -b chrome --mv3",
    "build:vivaldi": "wxt build -b chrome --mv3",
    "build:firefox": "wxt build -b firefox --mv2",
    "zip": "yarn zip:chromium && yarn zip:firefox",
    "zip:chromium": "wxt zip -b chrome --mv3",
    "zip:firefox": "wxt zip -b firefox --mv2",
    "package": "yarn zip",
    "verify": "node scripts/validate-builds.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "quality": "yarn lint && yarn test && yarn build && yarn verify"
  }
}
