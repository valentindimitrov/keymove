{
  "name": "keymove",
  "version": "1.0.0",
  "description": "A keyboard-first search interface for web pages.",
  "author": "Valentin Dimitrov",
  "license": "(Apache-2.0 AND BSD-4-Clause)",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.22",
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^30.1.1",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "5.0.3",
    "web-ext": "10.7.0",
    "wxt": "^0.21.4"
  },
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt -b chrome --mv3",
    "dev:firefox": "wxt -b firefox --mv3",
    "preview": "node scripts/preview-extension.ts",
    "preview:vivaldi": "node scripts/preview-extension.ts --browser=vivaldi",
    "preview:chrome": "node scripts/preview-extension.ts --browser=chrome",
    "preview:firefox": "node scripts/preview-extension.ts --browser=firefox",
    "browser:open": "node scripts/preview-extension.ts --no-build",
    "preview:ui": "vite --config preview/vite.config.ts",
    "website:dev": "vite --config website/vite.config.ts",
    "website:build": "vite build --config website/vite.config.ts",
    "website:preview": "vite preview --config website/vite.config.ts",
    "test:browser": "node scripts/preview-extension.ts --smoke",
    "test:browser:built": "node scripts/preview-extension.ts --smoke --no-build",
    "worktree:check": "node scripts/worktree-check.ts",
    "build": "pnpm build:chromium && pnpm build:firefox && pnpm build:safari",
    "build:chromium": "wxt build -b chrome --mv3",
    "build:vivaldi": "wxt build -b chrome --mv3",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:safari": "wxt build -b safari --mv3",
    "zip": "pnpm zip:chromium && pnpm zip:firefox && pnpm zip:safari",
    "zip:chromium": "wxt zip -b chrome --mv3",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "zip:safari": "wxt zip -b safari --mv3",
    "safari:project": "node scripts/safari-project.ts",
    "package:chrome": "pnpm zip:chromium && pnpm sign:chrome",
    "sign:chrome": "node scripts/sign-chrome.ts",
    "verify:crx": "node scripts/sign-chrome.ts --verify",
    "verify": "node scripts/validate-builds.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "test:tooling": "vitest run scripts",
    "test:changed": "vitest run --exclude=scripts/** --changed",
    "test:related": "vitest related --run --exclude=scripts/**",
    "test:watch": "vitest --exclude=scripts/**",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "quality": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm verify",
    "test:e2e": "pnpm build:chromium && playwright test",
    "test:e2e:built": "playwright test",
    "test:e2e:debug": "playwright test --debug=cli",
    "test:e2e:report": "playwright show-report .artifacts/playwright/report",
    "browser:install": "playwright install chromium",
    "browser:cli": "playwright-cli"
  }
}
