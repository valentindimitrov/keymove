        "default": ["ctrlKey", "metaKey", "shiftKey"]
      }
    },
    "displayKeys": {
      "default": ["Alt", "="],
      "mac": ["Option", "="]
    },
    "text": "to widen the searchbar"
  },
  {
    "name": "move_searchbar_left",
    "eventMatcher": {
      "code": "ArrowLeft",
      "flags": {
        "default": ["altKey", "shiftKey"]
      },
      "discludedFlags": {
        "default": ["ctrlKey", "metaKey"]
      }
    },
    "displayKeys": {
      "default": ["Alt", "Shift", "Arrows"],
      "mac": ["Option", "Shift", "Arrows"]
    },
    "text": "to move the searchbar"
  },
  {
    "name": "move_searchbar_right",
    "eventMatcher": {
      "code": "ArrowRight",
      "flags": {
        "default": ["altKey", "shiftKey"]
      },
      "discludedFlags": {
        "default": ["ctrlKey", "metaKey"]
      }
    }
  },
  {
    "name": "move_searchbar_up",
    "eventMatcher": {
      "code": "ArrowUp",
      "flags": {
        "default": ["altKey", "shiftKey"]
      },
      "discludedFlags": {
        "default": ["ctrlKey", "metaKey"]
      }
    }
  },
  {
    "name": "move_searchbar_down",
    "eventMatcher": {
      "code": "ArrowDown",
      "flags": {
        "default": ["altKey", "shiftKey"]
      },
      "discludedFlags": {
        "default": ["ctrlKey", "metaKey"]
      }
