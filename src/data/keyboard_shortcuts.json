[
  {
    "name": "next_match",
    "eventMatcher": {
      "code": "Tab",
      "discludedFlags": {
        "default": ["shiftKey", "ctrlKey", "metaKey", "altKey"]
      }
    },
    "displayKeys": {
      "default": ["Tab"]
    },
    "text": "to select the next matching text block"
  },
  {
    "name": "previous_match",
    "eventMatcher": {
      "code": "Tab",
      "flags": {
        "default": ["shiftKey"]
      },
      "discludedFlags": {
        "default": ["ctrlKey", "metaKey", "altKey"]
      }
    },
    "displayKeys": {
      "default": ["Shift", "Tab"]
    },
    "text": "to select the previous matching text block"
  },
  {
    "name": "next_action_match",
    "eventMatcher": {
      "code": "Tab",
      "flags": {
        "default": ["ctrlKey"]
      },
      "discludedFlags": {
        "default": ["shiftKey", "metaKey", "altKey"]
      }
    },
    "displayKeys": {
      "default": ["Control", "Tab"]
    },
    "text": "to select the next matching action"
  },
  {
    "name": "previous_action_match",
    "eventMatcher": {
      "code": "Tab",
      "flags": {
        "default": ["ctrlKey", "shiftKey"]
      },
      "discludedFlags": {
        "default": ["metaKey", "altKey"]
      }
    },
    "displayKeys": {
      "default": ["Shift", "Control", "Tab"]
    },
    "text": "to select the previous matching action"
  },
  {
    "name": "toggle_search_mode",
    "eventMatcher": {
      "code": "KeyS",
      "flags": {
        "default": ["altKey"]
      },
      "discludedFlags": {
        "default": ["ctrlKey", "metaKey", "shiftKey"]
      }
    },
    "displayKeys": {
      "default": ["Alt", "S"],
      "mac": ["Option", "S"]
    },
    "text": "to switch between matching text and matching actions"
  },
  {
    "name": "select_match",
    "eventMatcher": {
      "code": "Enter",
      "discludedFlags": {
        "default": ["shiftKey", "ctrlKey", "metaKey", "altKey"]
      }
    },
    "displayKeys": {
      "default": ["Enter"]
    },
    "text": "to open the selected action"
  },
  {
    "name": "open_match_in_foreground_tab",
    "eventMatcher": {
      "code": "Enter",
      "flags": {
        "default": ["shiftKey"]
      },
      "discludedFlags": {
        "default": ["ctrlKey", "metaKey", "altKey"]
      }
    },
    "displayKeys": {
      "default": ["Shift", "Enter"]
    },
    "text": "to open the selected link in a new tab"
  },
  {
    "name": "open_match_in_background_tab",
    "eventMatcher": {
      "code": "Enter",
      "flags": {
        "default": ["ctrlKey"]
      },
      "discludedFlags": {
        "default": ["shiftKey", "metaKey", "altKey"]
      }
    },
    "displayKeys": {
      "default": ["Control", "Enter"]
    },
    "text": "to open the selected link in a background tab"
  },
  {
    "name": "copy_selected_link",
    "eventMatcher": {
      "code": "KeyC",
      "flags": {
        "default": ["ctrlKey"],
        "mac": ["metaKey"]
      },
      "discludedFlags": {
        "default": ["shiftKey", "metaKey", "altKey"],
        "mac": ["shiftKey", "ctrlKey", "altKey"]
      }
    },
    "displayKeys": {
      "default": ["Control", "C"],
      "mac": ["Command", "C"]
    },
    "text": "to copy the selected link (or selected text block)"
  },
  {
    "name": "clear_searchbar",
    "eventMatcher": {
      "code": "Backspace",
      "flags": {
        "default": ["ctrlKey"],
        "mac": ["metaKey"]
      }
    },
    "displayKeys": {
      "default": ["Control", "Backspace"],
      "mac": ["Command", "Backspace"]
    },
    "text": "to clear the searchbar"
  },
  {
    "name": "focus_searchbar",
    "eventMatcher": {
      "code": "KeyF",
      "flags": {
        "default": ["altKey"]
      }
    },
    "displayKeys": {
      "default": ["Alt", "F"],
      "mac": ["Option", "F"]
    },
    "text": "to focus the searchbar (or just start typing)"
  },
  {
    "name": "narrow_searchbar",
    "eventMatcher": {
      "code": "Minus",
      "flags": {
        "default": ["altKey"]
      },
      "discludedFlags": {
        "default": ["ctrlKey", "metaKey", "shiftKey"]
      }
    },
    "displayKeys": {
      "default": ["Alt", "-"],
      "mac": ["Option", "-"]
    },
    "text": "to narrow the searchbar"
  },
  {
    "name": "widen_searchbar",
    "eventMatcher": {
